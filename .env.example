# ==============================================================================
# Plate Pantry — Environment Configuration Template
# Copy this file to .env and adjust the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=5360
HOST=0.0.0.0

# Base path prefix if mounted behind a subpath (e.g. /plate-pantry)
NEXT_PUBLIC_PLATE_PANTRY_BASE_PATH=/plate-pantry

# Canonical public origin used for SEO, canonical links, and CORS
PLATE_PANTRY_PUBLIC_ORIGIN=http://localhost:5360

# Identifier reported in the x-plate-pantry-ssr-origin response header
PLATE_PANTRY_SSR_ORIGIN=plate-pantry

# Host volume directory for persistent data (plate lookups and stats)
PLATE_PANTRY_DATA_DIR=./data

# Container data directory (defaults to /data in Docker)
PLATE_PANTRY_STATS_DIR=/data

# Set to 1 in container/server environments to disable opening a desktop browser
PLATE_PANTRY_NO_OPEN=1

# ------------------------------------------------------------------------------
# 2. Origin Security & Rate Limiting (Recommended for Public Deployments)
# ------------------------------------------------------------------------------
# If set, requests directly to the origin require this secret in the
# 'x-plate-pantry-origin-secret' header. Direct access without it returns 403.
# Generate with: openssl rand -hex 32
PLATE_PANTRY_ORIGIN_SECRET=

# Max plate lookup requests per client IP per minute (default: 20)
PLATE_PANTRY_RATE_LIMIT_PER_MINUTE=20

# Max unique plate entries retained in persistent stats before LRU eviction
PLATE_PANTRY_MAX_STATS_ENTRIES=10000

# ------------------------------------------------------------------------------
# 3. NY DMV Backend & Proxy Configuration
# ------------------------------------------------------------------------------
# Internal port for the DMV backend service
DMV_BACKEND_PORT=8080

# Whether lookups require an HTTP proxy (1 = fail-closed if no proxy, 0 = direct)
DMV_PROXY_REQUIRED=0

# Upstream proxy URL if routing lookups through a VPN/proxy (e.g. Gluetun, Squid)
# Format: http://<host>:<port>
DMV_PROXY_URL=

# ------------------------------------------------------------------------------
# 4. Cloudflare Edge Relay (Optional)
# ------------------------------------------------------------------------------
# Only needed if deploying edge/worker.ts via Cloudflare Workers
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PLATE_PANTRY_ORIGIN_URL=
